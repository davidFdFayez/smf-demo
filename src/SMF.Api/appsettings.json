{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=SMF;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=True;"
  },
  "Jwt": {
    "Issuer": "smf-api",
    "Audience": "smf-clients",
    "SigningKey": "REPLACE_ME_WITH_A_SECURE_32+_CHAR_SECRET_FROM_A_SECRET_STORE",
    "TokenLifetimeMinutes": 480
  },
  "Payments": {
    "SandboxCheckoutBaseUrl": "https://sandbox.smf.local/checkout",
    "WebhookSigningSecret": "REPLACE_ME_WITH_PROVIDER_SHARED_SECRET",
    "WebhookSignatureHeader": "X-Smf-Signature"
  },
  "Email": {
    "Provider": "Logging",
    "FromAddress": "no-reply@smf.local",
    "FromName": "Saudi MuayThai Federation",
    "Smtp": {
      "Host": "localhost",
      "Port": 1025,
      "UseStartTls": false,
      "UseSslOnConnect": false,
      "Username": "",
      "Password": ""
    },
    "SendGrid": {
      "ApiKey": "",
      "ApiBaseUrl": "https://api.sendgrid.com"
    }
  },
  "Sms": {
    "Provider": "Logging",
    "DefaultSenderId": "SMF",
    "Unifonic": {
      "AppSid": "",
      "SenderId": "",
      "ApiBaseUrl": "https://el.cloud.unifonic.com"
    },
    "Twilio": {
      "AccountSid": "",
      "AuthToken": "",
      "FromPhoneE164": "",
      "ApiBaseUrl": "https://api.twilio.com"
    }
  },
  "Push": {
    "Provider": "Logging",
    "ServiceAccountJson": "",
    "ServiceAccountJsonPath": "",
    "ProjectId": ""
  },
  "Chatbot": {
    "Provider": "OpenAI",
    "BaseUrl": "https://api.openai.com",
    "ApiKey": "",
    "Model": "gpt-4o-mini",
    "Temperature": 0.2,
    "MaxTokens": 600
  },
  "Compliance": {
    "SigningSecret": "DEV-ONLY-CHANGE-ME-32-BYTES-MINIMUM-COMPLIANCE-SECRET",
    "PublicBaseUrl": "",
    "Storage": {
      "Provider": "Local",
      "LocalRoot": "App_Data/uploads",
      "PublicUrlPrefix": "/files"
    }
  }
}
