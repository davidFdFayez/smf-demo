# ---------------------------------------------------------------------------
# Copy to `.env` (same directory as docker-compose.yml) and edit to taste.
#   cp .env.example .env          # Linux / macOS
#   Copy-Item .env.example .env   # PowerShell
# ---------------------------------------------------------------------------

# --- Host ports (change if 8080/8081/5080/11433 are taken) -----------------
WEB_PORT=8080
ADMIN_PORT=8081
API_PORT=5080
DB_PORT=11433

# --- Database -------------------------------------------------------------
# SQL Server SA password. Must satisfy MSSQL's complexity rules:
# 8+ chars, upper + lower + digit + symbol.
DB_SA_PASSWORD=Smf_Demo_Passw0rd!

# --- Security -------------------------------------------------------------
# HS256 signing key for JWTs. MUST be at least 32 characters in production.
# Generate one with e.g.:
#   openssl rand -base64 48
#   [Convert]::ToBase64String((1..48 | % { Get-Random -Max 256 }))  # PowerShell
JWT_SIGNING_KEY=please-override-in-env-at-least-32-chars-long-demo-secret

# --- Public origin (SnapDeploy / cloud deploy) ------------------------------
# Set to the exact HTTPS URL from your SnapDeploy dashboard (no trailing slash).
# Example: https://smf-demo.containers.snapdeploy.dev
PUBLIC_ORIGIN=https://your-container.containers.snapdeploy.dev
