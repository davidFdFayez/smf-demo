# Copy to .env.cloud on your cloud server (bootstrap-vps.sh creates this automatically).

DB_SA_PASSWORD=ChangeMe_Strong_Db_Pass_123!
JWT_SIGNING_KEY=change-me-to-a-random-32-plus-character-secret-key

# Auto-set by bootstrap-vps.sh from server public IP (203-0-113-10.sslip.io format)
SSLIP_HOST=203-0-113-10.sslip.io
PUBLIC_WEB_ORIGIN=https://203-0-113-10.sslip.io
PUBLIC_ADMIN_ORIGIN=https://admin.203-0-113-10.sslip.io

